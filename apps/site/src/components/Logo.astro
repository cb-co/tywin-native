---
import { BIRD_BODY, BIRD_WING } from "@cigua/core/papel/bird";
import { BRAND_TILE as T } from "@cigua/core/papel/brand-tile";
import { tilePlatePath } from "../lib/rosette-svg";

/* The favicon's mark at nav size (and the app header's): a note-violet tile,
   the guilloche plate engraved in its centre, the seal on top. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const PLATE = tilePlatePath();
const seal = 64 * T.seal;
const offset = 32 - seal / 2;
---

<span class:list={["logo", className]} aria-hidden="true">
  <svg viewBox="0 0 64 64" fill="none">
    <rect width="64" height="64" rx={64 * T.radius} fill="var(--note)"></rect>
    <path d={PLATE} stroke="var(--note-ink)" stroke-width={T.plateLine} stroke-linejoin="round" opacity={T.plateOpacity}></path>
    <g transform={`translate(${offset} ${offset}) scale(${seal / 64})`} stroke="var(--note-ink)">
      <circle cx="32" cy="32" r="32" fill="var(--note)" stroke="none"></circle>
      <circle cx="32" cy="32" r="30.5" stroke-width="1.8"></circle>
      <circle cx="32" cy="32" r="22" stroke-width="1.4"></circle>
      <g transform="translate(-0.8 0.2)" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
        <path d={BIRD_WING}></path>
        <path d={BIRD_BODY}></path>
      </g>
    </g>
  </svg>
</span>

<style>
  .logo {
    display: inline-flex;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    user-select: none;
  }
  svg {
    width: 100%;
    height: 100%;
  }
</style>
