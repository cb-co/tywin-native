---
import { medallionSvg } from "@cigua/core/papel/medallion";

/* The Cigua mark (@cigua/core/papel/medallion). The ring takes the text
   colour, so it is light on the violet hero and ink on paper, in either theme. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const SVG = medallionSvg({ plate: "currentColor", disc: "var(--note)", ink: "var(--note-ink)" });
---

<span class:list={["logo", className]} aria-hidden="true" set:html={SVG} />

<style>
  .logo {
    display: inline-flex;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    user-select: none;
  }
  .logo :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
