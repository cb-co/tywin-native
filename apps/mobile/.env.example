# Copy to .env.local and fill in. All three are public by design: the
# publishable key only ever acts as the signed-in person, under row-level security.

# The Worker (apps/worker). `npm run dev:worker` serves it on :8787; on a device,
# use your machine's LAN address rather than localhost.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Supabase project URL and publishable (anon) key, used on the device for Auth only.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
